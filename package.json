{
  "name": "@druloloy/bacon-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Bacon — the React Native design library for the Bacon app. Tokens, components, and screen templates built from the Bacon Brand & Interface Guide.",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/*.stories.tsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:a11y": "jest tests/accessibility",
    "test:brand": "jest tests/brand",
    "test:integration": "jest tests/integration",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:package",
    "storybook": "npm --prefix example run storybook",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "bob build"
  },
  "keywords": [
    "bacon",
    "design-system",
    "react-native",
    "ui",
    "components",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druloloy/bacon-design-library.git"
  },
  "bugs": {
    "url": "https://github.com/druloloy/bacon-design-library/issues"
  },
  "homepage": "https://github.com/druloloy/bacon-design-library#readme",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0",
    "react-native-safe-area-context": ">=4.8.0"
  },
  "peerDependenciesMeta": {
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@storybook/react": "^8.6.18",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.6",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "babel-preset-expo": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-builder-bob": "^0.23.2",
    "react-native-safe-area-context": "4.8.2",
    "react-test-renderer": "18.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": false
        }
      ],
      [
        "module",
        {
          "esm": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
